<!-- 建立使用者右側滑出抽屜 (Offcanvas Drawer) -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="userDrawer" aria-labelledby="userDrawerLabel" style="width: 520px;">
    <div class="offcanvas-header bg-dark text-white">
        <h2 class="offcanvas-title fw-bold" id="userDrawerLabel">
            <i class="ti ti-user-plus text-primary me-2"></i>建立新系統帳號
        </h2>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-4">
        <!-- 說明卡 -->
        <div class="alert alert-info border-0 shadow-sm mb-4">
            <div class="d-flex">
                <i class="ti ti-shield-lock fs-2 me-2"></i>
                <div class="small">
                    <strong>RBAC 權限與部門資料隔離：</strong><br />
                    • 指派角色決定功能模組的存取權力。<br />
                    • 指定部門將嚴格限制單據與資料的查詢隔離範圍。
                </div>
            </div>
        </div>

        <form id="formCreateUser" autocomplete="off">
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label required small">登入帳號</label>
                    <input type="text" class="form-control" id="newUsername" placeholder="英文或數字" required />
                </div>
                <div class="col-6">
                    <label class="form-label required small">顯示姓名</label>
                    <input type="text" class="form-control" id="newDisplayName" placeholder="例如：李採購" required />
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label required small">登入密碼</label>
                    <input type="password" class="form-control" id="newPassword" placeholder="至少 6 碼" required />
                </div>
                <div class="col-6">
                    <label class="form-label required small">指派角色</label>
                    <select class="form-select" id="newRole" required>
                        <option value="Warehouse">👷 現場倉管 (Warehouse)</option>
                        <option value="Purchaser">👤 採購人員 (Purchaser)</option>
                        <option value="Manager">👔 倉儲主管 (Manager)</option>
                        <option value="Admin">👑 系統管理員 (Admin)</option>
                    </select>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label required small">所屬部門 / 單位 (落實資料級隔離)</label>
                <input type="text" class="form-control" id="newDepartment" placeholder="例: 總務課、資材部、製造部" value="總務課" required list="userDeptOptions" />
                <datalist id="userDeptOptions">
                    <option value="總務課" />
                    <option value="資材部" />
                    <option value="製造部" />
                    <option value="營運處" />
                    <option value="資訊部" />
                    <option value="業務部" />
                </datalist>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold" id="btnSubmitUser">
                <i class="ti ti-check me-1"></i>確認建立帳號
            </button>
        </form>
    </div>
</div>

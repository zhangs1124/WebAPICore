@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var sessionJson = HttpContextAccessor.HttpContext?.Session.GetString("UserSession");
    WebAPICore.Api.Models.UserSession? currentSession = null;
    if (!string.IsNullOrEmpty(sessionJson))
    {
        currentSession = System.Text.Json.JsonSerializer.Deserialize<WebAPICore.Api.Models.UserSession>(sessionJson);
    }
    var currentRole = currentSession?.Role ?? "Warehouse";
    var displayName = currentSession?.DisplayName ?? "現場倉管員";
    var username = currentSession?.Username ?? "warehouse";
}
<header class="navbar navbar-expand-md d-none d-lg-flex d-print-none border-bottom sticky-top">
    <div class="container-xl">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-nav flex-row order-md-last align-items-center">
            <!-- 採購抽屜快捷鍵 (Purchaser, Manager, Admin) -->
            <button type="button" class="btn btn-outline-warning btn-sm me-2 role-purchaser-only" data-bs-toggle="offcanvas" data-bs-target="#purchaseDrawer" onclick="loadPurchaseOrders()">
                <i class="ti ti-shopping-cart me-1"></i>採購管理 (PO)
            </button>

            <!-- 帳號管理抽屜快捷鍵 (Admin 專屬) -->
            <button type="button" class="btn btn-outline-primary btn-sm me-3 role-admin-only" data-bs-toggle="offcanvas" data-bs-target="#userDrawer" onclick="loadUsersList()">
                <i class="ti ti-users-group me-1"></i>帳號權限
            </button>

            <!-- 深淺主題切換按鈕 -->
            <div class="d-none d-md-flex me-3">
                <a href="javascript:void(0);" class="nav-link px-0 hide-theme-dark" title="切換為暗黑模式" onclick="toggleTablerTheme('dark')">
                    <i class="ti ti-moon fs-2"></i>
                </a>
                <a href="javascript:void(0);" class="nav-link px-0 hide-theme-light" title="切換為明亮模式" onclick="toggleTablerTheme('light')">
                    <i class="ti ti-sun fs-2 text-warning"></i>
                </a>
            </div>

            <!-- 使用者頭像與選單 -->
            <div class="nav-item dropdown">
                <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Open user menu">
                    <span class="avatar avatar-sm bg-primary-lt fw-bold">@username.Substring(0, Math.Min(2, username.Length)).ToUpperInvariant()</span>
                    <div class="d-none d-xl-block ps-2">
                        <div class="fw-bold">@displayName</div>
                        <div class="mt-1 small">
                            @if (currentRole == "Admin")
                            {
                                <span class="badge bg-red-lt">👑 系統管理員</span>
                            }
                            else if (currentRole == "Manager")
                            {
                                <span class="badge bg-yellow-lt">👔 倉儲主管</span>
                            }
                            else if (currentRole == "Purchaser")
                            {
                                <span class="badge bg-blue-lt">👤 採購專員</span>
                            }
                            else
                            {
                                <span class="badge bg-green-lt">👷 現場倉管</span>
                            }
                        </div>
                    </div>
                </a>
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                    <div class="dropdown-header">登入身分：@currentRole</div>
                    <a href="javascript:void(0);" class="dropdown-item" onclick="refreshDashboard()"><i class="ti ti-refresh me-2"></i>重新整理數據</a>
                    <a href="javascript:void(0);" class="dropdown-item role-purchaser-only" data-bs-toggle="offcanvas" data-bs-target="#purchaseDrawer" onclick="loadPurchaseOrders()"><i class="ti ti-shopping-cart me-2"></i>開啟採購抽屜</a>
                    <a href="javascript:void(0);" class="dropdown-item role-admin-only" data-bs-toggle="offcanvas" data-bs-target="#userDrawer" onclick="loadUsersList()"><i class="ti ti-users-group me-2"></i>開啟帳號權限抽屜</a>
                    <div class="dropdown-divider"></div>
                    <a href="/scalar/v1" target="_blank" class="dropdown-item"><i class="ti ti-code me-2"></i>Scalar API 測試</a>
                    <div class="dropdown-divider"></div>
                    <a href="/Account/Logout" class="dropdown-item text-danger"><i class="ti ti-logout me-2"></i>登出系統</a>
                </div>
            </div>
        </div>

        <div class="collapse navbar-collapse" id="navbar-menu">
            <div class="my-2 my-md-0 flex-grow-1 flex-md-grow-0 order-first order-md-last">
                <div class="input-icon">
                    <span class="input-icon-addon">
                        <i class="ti ti-search"></i>
                    </span>
                    <input type="text" id="globalSearchInput" class="form-control" placeholder="搜尋商品 SKU、品名... (按 Enter 搜尋)" aria-label="Search in website">
                    <span class="input-icon-addon">
                        <kbd class="kbd">Ctrl + K</kbd>
                    </span>
                </div>
            </div>
        </div>
    </div>
</header>

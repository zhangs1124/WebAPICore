<!-- 建立供應商右側滑出抽屜 (Offcanvas Drawer) -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="supplierDrawer" aria-labelledby="supplierDrawerLabel" style="width: 520px;">
    <div class="offcanvas-header bg-dark text-white">
        <h2 class="offcanvas-title fw-bold" id="supplierDrawerLabel">
            <i class="ti ti-building-store text-info me-2"></i>新增合作供應商主檔
        </h2>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-4">
        <!-- 說明提示卡 -->
        <div class="alert alert-info border-0 shadow-sm mb-4">
            <div class="d-flex">
                <i class="ti ti-info-circle fs-2 me-2"></i>
                <div class="small">
                    <strong>供應商主檔建立提示：</strong><br />
                    • 代碼建議以英數字命名（如 SUP-005）。<br />
                    • 建立成功後將立即同步至中央主表與採購開單選單。
                </div>
            </div>
        </div>

        <form id="formCreateSupplier" autocomplete="off">
            <div class="row g-2 mb-3">
                <div class="col-5">
                    <label class="form-label required small">供應商代碼</label>
                    <input type="text" class="form-control font-monospace text-uppercase" id="newSupCode" placeholder="如: SUP-005" required />
                </div>
                <div class="col-7">
                    <label class="form-label required small">廠商公司名稱</label>
                    <input type="text" class="form-control" id="newSupName" placeholder="例如: 台灣電子通路" required />
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label required small">主要聯絡窗口</label>
                    <input type="text" class="form-control" id="newSupContact" placeholder="聯絡窗口姓名" required />
                </div>
                <div class="col-6">
                    <label class="form-label required small">聯絡電話</label>
                    <input type="text" class="form-control" id="newSupPhone" placeholder="市話或手機" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small">電子郵件 (選填)</label>
                <input type="email" class="form-control" id="newSupEmail" placeholder="supplier@example.com" />
            </div>

            <div class="mb-4">
                <label class="form-label small">公司地址 (選填)</label>
                <input type="text" class="form-control" id="newSupAddress" placeholder="營業或出貨地址" />
            </div>

            <button type="submit" class="btn btn-info text-white w-100 fw-bold" id="btnSubmitSupplier">
                <i class="ti ti-check me-1"></i>確認建立供應商
            </button>
        </form>
    </div>
</div>

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>@ViewData["Title"] - 智庫存 ERP 管理系統</title>

    <!-- 🌓 防閃爍 (No FOUC) 機制：在 DOM 渲染前立即讀取並注入主題 -->
    <script>
        (function () {
            var theme = localStorage.getItem('tabler-theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>

    <!-- Google Fonts Inter 字體 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tabler Core CSS (Bootstrap 5) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta20/dist/css/tabler.min.css" />
    <!-- Tabler Webfont Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
    <!-- SweetAlert2 現代化彈窗 / Toast -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

    <style>
        :root {
            --tblr-font-sans-serif: 'Inter', -apple-system, BlinkMacSystemFont, San Francisco, Segoe UI, Roboto, Helvetica Neue, sans-serif;
            font-feature-settings: "cv03", "cv04", "cv11";
        }
        .modal-blur {
            backdrop-filter: blur(4px);
        }

        /* 側邊欄平滑手風琴收折動畫 */
        #mainSidebar {
            transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            z-index: 1020;
        }

        body.sidebar-collapsed #mainSidebar {
            margin-left: -250px;
            opacity: 0;
            pointer-events: none;
        }

        .page-wrapper {
            transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
            width: 100%;
        }

        .nav-menu-link.active {
            background-color: rgba(32, 107, 196, 0.2) !important;
            color: #4299e1 !important;
            font-weight: 600 !important;
            border-radius: 4px;
        }
    </style>
</head>
<body class="layout-fluid">
    <div class="page">
        <!-- 側邊欄導覽 (Partial View) -->
        <partial name="_Sidebar" />

        <div class="page-wrapper">
            <!-- 頂部導覽 (Partial View) -->
            <partial name="_Header" />

            <!-- 主內容區 -->
            <main class="page-body">
                <div class="container-fluid px-4 py-3">
                    @RenderBody()
                </div>
            </main>

            <!-- 頁尾 (Partial View) -->
            <partial name="_Footer" />
        </div>
    </div>

    <!-- 右側滑出抽屜 (Offcanvas Drawers) -->
    <partial name="_UserDrawer" />
    <partial name="_SupplierDrawer" />
    <partial name="_PurchaseDrawer" />
    <partial name="_StocktakeDrawer" />

    <!-- Tabler Core JS (Bootstrap 5) -->
    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta20/dist/js/tabler.min.js"></script>
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @inject Microsoft.AspNetCore.Http.IHttpContextAccessor LayoutHttpAccessor
    @{
        var laySession = LayoutHttpAccessor.HttpContext?.Session.GetString("UserSession");
        var layRole = "Warehouse";
        var layName = "現場倉管員";
        var layDept = "總務課";
        if (!string.IsNullOrEmpty(laySession))
        {
            var s = System.Text.Json.JsonSerializer.Deserialize<WebAPICore.Api.Models.UserSession>(laySession);
            if (s != null)
            {
                layRole = s.Role;
                layName = s.DisplayName;
                layDept = s.Department;
            }
        }
    }

    <!-- 全域主題切換與共用通知腳本 -->
    <script>
        window.currentUserRole = '@layRole';
        window.currentUserName = '@layName';
        window.currentUserDept = '@layDept';

        // 側邊欄收折手風琴控制
        function toggleSidebarMenu() {
            document.body.classList.toggle('sidebar-collapsed');
            const isCollapsed = document.body.classList.contains('sidebar-collapsed');
            localStorage.setItem('tabler-sidebar-collapsed', isCollapsed ? '1' : '0');
        }

        // 初始化側邊欄狀態
        (function() {
            if (localStorage.getItem('tabler-sidebar-collapsed') === '1') {
                document.body.classList.add('sidebar-collapsed');
            }
        })();

        function toggleTablerTheme(theme) {
            localStorage.setItem('tabler-theme', theme);
            document.documentElement.setAttribute('data-bs-theme', theme);
        }

        // SweetAlert2 全域 Toast
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true
        });

        // 全域鍵盤快速鍵 Ctrl + K 聚焦搜尋
        document.addEventListener('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                const search = document.getElementById('globalSearchInput');
                if (search) search.focus();
            }
        });

        // 依據角色動態控制 UI 顯示/遮蔽 (顯現管控核心)
        function applyRolePermissions() {
            const role = window.currentUserRole;

            // 1. Admin 專屬控制項
            document.querySelectorAll('.role-admin-only').forEach(el => {
                el.style.display = (role === 'Admin') ? '' : 'none';
            });

            // 2. Manager 專屬控制項 (審核、盤點校正)
            document.querySelectorAll('.role-manager-only').forEach(el => {
                el.style.display = (role === 'Manager' || role === 'Admin') ? '' : 'none';
            });

            // 3. Purchaser 專屬控制項 (填寫採購單、供應商管理)
            document.querySelectorAll('.role-purchaser-only').forEach(el => {
                el.style.display = (role !== 'Warehouse') ? '' : 'none';
            });

            // 4. 進價成本遮蔽 (倉管員看不到進價)
            document.querySelectorAll('.price-cost-cell').forEach(el => {
                if (role === 'Warehouse') {
                    if (!el.dataset.rawPrice) el.dataset.rawPrice = el.innerText;
                    el.innerText = '***';
                    el.title = '現場作業員無權限檢視成本單價';
                } else if (el.dataset.rawPrice) {
                    el.innerText = el.dataset.rawPrice;
                }
            });
        }

        document.addEventListener('DOMContentLoaded', applyRolePermissions);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

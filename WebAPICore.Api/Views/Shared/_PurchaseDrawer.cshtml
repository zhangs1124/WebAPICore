<!-- 建立採購訂購單右側滑出抽屜 (Offcanvas Drawer) -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="purchaseDrawer" aria-labelledby="purchaseDrawerLabel" style="width: 580px;">
    <div class="offcanvas-header bg-dark text-white">
        <h2 class="offcanvas-title fw-bold" id="purchaseDrawerLabel">
            <i class="ti ti-file-plus text-warning me-2"></i>建立採購訂購單 (PO)
        </h2>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-4">
        <!-- 說明卡 -->
        <div class="alert alert-warning border-0 shadow-sm mb-4">
            <div class="d-flex">
                <i class="ti ti-info-circle fs-2 me-2"></i>
                <div class="small">
                    <strong>請購訂購二合一流程：</strong><br />
                    • 送出後進入「草稿待審」狀態。<br />
                    • 經主管核准後自動轉為「已核准在途」，商品自動累加至在途量。<br />
                    • 現場倉管員貨到驗收後即可入庫。
                </div>
            </div>
        </div>

        <form id="formCreatePO" autocomplete="off">
            <div class="mb-3">
                <label class="form-label required small d-flex justify-content-between">
                    <span>合作供應商</span>
                    <a href="javascript:void(0);" onclick="openCreateSupplierDrawer()" class="small text-decoration-none">
                        <i class="ti ti-plus"></i> 新增供應商主檔
                    </a>
                </label>
                <select class="form-select" id="poSupplierSelect" required>
                    <option value="">-- 請選擇合作供應商 --</option>
                </select>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-7">
                    <label class="form-label required small">採購商品品項</label>
                    <select class="form-select" id="poProductSelect" required>
                        <option value="">載入商品中...</option>
                    </select>
                </div>
                <div class="col-5">
                    <label class="form-label required small">採購數量</label>
                    <input type="number" class="form-control" id="poQuantity" min="1" value="10" required />
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label required small">進貨成本單價 (NT$)</label>
                    <input type="number" class="form-control" id="poUnitPrice" min="0.01" step="0.01" placeholder="單價" required />
                </div>
                <div class="col-6">
                    <label class="form-label small">備註說明 (選填)</label>
                    <input type="text" class="form-control" id="poRemark" placeholder="專案或急件說明" />
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-warning w-100 fw-bold" id="btnSubmitPO">
                    <i class="ti ti-send me-1"></i>確認送出採購單審核
                </button>
            </div>
        </form>
    </div>
</div>

@{
    ViewData["Title"] = "營運總覽儀表板";
}

<!-- 頁面標題列 -->
<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle text-secondary">INVENTORY MANAGEMENT SYSTEM</div>
            <h2 class="page-title fw-bold">
                <i class="ti ti-building-warehouse text-primary me-2"></i>倉儲進銷存營運總覽
            </h2>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <div class="btn-list">
                <button type="button" class="btn btn-outline-secondary" onclick="refreshDashboard()">
                    <i class="ti ti-refresh me-1"></i>重新整理
                </button>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#productModal">
                    <i class="ti ti-plus me-1"></i>新增商品
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 4 欄式 KPI 營運指標卡 (Metric Strips) -->
<div class="row row-deck row-cards mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-primary text-white avatar fs-2">
                            <i class="ti ti-box"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="font-weight-medium text-secondary small">商品總品項數</div>
                        <div class="text-reset fw-bold fs-1" id="kpiTotalProducts">0</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-green text-white avatar fs-2">
                            <i class="ti ti-packages"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="font-weight-medium text-secondary small">在庫現存總件數</div>
                        <div class="text-reset fw-bold fs-1" id="kpiTotalStock">0</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-warning text-white avatar fs-2">
                            <i class="ti ti-alert-triangle"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="font-weight-medium text-secondary small">安全庫存警戒數</div>
                        <div class="text-reset fw-bold fs-1" id="kpiLowStockCount">0</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-purple text-white avatar fs-2">
                            <i class="ti ti-server"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="font-weight-medium text-secondary small">雲端資料庫狀態</div>
                        <div class="text-reset fw-bold fs-2 text-success">
                            <span class="status-dot status-dot-animated bg-green me-1"></span>正常
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 即時商品庫存數據表格 -->
<div class="card border-0 shadow-sm" id="productsSection">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h3 class="card-title fw-bold">
            <i class="ti ti-table me-1"></i>商品即時庫存明細
        </h3>
        <div class="d-flex gap-2">
            <input type="text" id="filterSearch" class="form-control form-control-sm" placeholder="搜尋 SKU 或名稱..." style="width: 200px;" onkeyup="handleFilterKey(event)">
            <select id="filterCategory" class="form-select form-select-sm" style="width: 140px;" onchange="loadProducts()">
                <option value="">全部類別</option>
                <option value="電腦周邊">電腦周邊</option>
                <option value="辦公設備">辦公設備</option>
                <option value="生活家電">生活家電</option>
                <option value="耗材配件">耗材配件</option>
            </select>
            <button class="btn btn-sm btn-primary" onclick="loadProducts()">
                <i class="ti ti-search me-1"></i>查詢
            </button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-hover">
            <thead>
                <tr>
                    <th>商品貨號 (SKU)</th>
                    <th>商品名稱</th>
                    <th>分類</th>
                    <th class="text-end">銷售單價</th>
                    <th style="min-width: 160px;">現有庫存狀況</th>
                    <th class="text-center">安全庫存線</th>
                    <th class="text-center">狀態</th>
                    <th class="text-end">快速出入庫</th>
                </tr>
            </thead>
            <tbody id="productsTableBody">
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                        正在向 Supabase 雲端讀取庫存資料...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="card-footer d-flex align-items-center py-2" id="tablePagination">
        <p class="m-0 text-secondary small" id="paginationInfo">顯示第 0 筆至 0 筆，共 0 筆</p>
    </div>
</div>

<!-- 低於安全庫存預警區塊 -->
<div class="card border-0 shadow-sm mt-4 border-start border-warning border-3" id="lowStockSection">
    <div class="card-header bg-warning-lt py-2">
        <h4 class="card-title text-warning fw-bold m-0">
            <i class="ti ti-bell-ringing me-1"></i>急需補貨商品警戒區 (現有庫存 &le; 安全庫存)
        </h4>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-sm">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>品名</th>
                        <th>現存數量</th>
                        <th>安全警戒線</th>
                        <th>建議採購補貨量</th>
                        <th class="text-end">動作</th>
                    </tr>
                </thead>
                <tbody id="lowStockTableBody">
                    <tr><td colspan="6" class="text-center text-muted py-3">載入中...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 嵌入 Partial View 彈窗 -->
<partial name="_ProductModal" />
<partial name="_StockModal" />

@section Scripts {
<script>
    let currentProductsList = [];

    document.addEventListener("DOMContentLoaded", () => {
        refreshDashboard();
    });

    // 重新載入所有儀表板資料
    async function refreshDashboard() {
        await Promise.all([
            loadProducts(),
            loadLowStock()
        ]);
    }

    function handleFilterKey(e) {
        if (e.key === "Enter") {
            loadProducts();
        }
    }

    // 1. 取得商品清單 (呼叫 GET /api/v1/products)
    async function loadProducts() {
        const search = document.getElementById("filterSearch").value.trim();
        const category = document.getElementById("filterCategory").value;
        const tbody = document.getElementById("productsTableBody");

        let url = `/api/v1/products?pageNumber=1&pageSize=50`;
        if (search) url += `&search=${encodeURIComponent(search)}`;
        if (category) url += `&category=${encodeURIComponent(category)}`;

        try {
            const res = await fetch(url);
            if (!res.ok) throw new Error("讀取商品失敗");
            const data = await res.json();
            currentProductsList = data.items;

            // 計算 KPI
            document.getElementById("kpiTotalProducts").innerText = data.totalCount;
            let totalStock = 0;
            currentProductsList.forEach(p => totalStock += p.currentQty);
            document.getElementById("kpiTotalStock").innerText = totalStock.toLocaleString();

            document.getElementById("paginationInfo").innerText = `共 ${data.totalCount} 筆商品品項`;

            if (currentProductsList.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-muted">目前暫無商品，請點擊上方「+ 新增商品」建立第一筆資料！</td></tr>`;
                return;
            }

            let rows = "";
            currentProductsList.forEach(p => {
                const isLow = p.isLowStock;
                const statusBadge = isLow
                    ? `<span class="badge bg-danger-lt"><i class="ti ti-alert-circle me-1"></i>庫存吃緊</span>`
                    : `<span class="badge bg-success-lt"><i class="ti ti-check me-1"></i>庫存充裕</span>`;

                const progressColor = isLow ? "bg-danger" : "bg-primary";
                const ratio = p.safetyStock > 0 ? Math.min(100, Math.round((p.currentQty / (p.safetyStock * 2)) * 100)) : 100;

                rows += `
                <tr>
                    <td class="font-monospace text-primary fw-bold">${p.sku}</td>
                    <td class="fw-semibold">${p.name}</td>
                    <td><span class="badge bg-secondary-lt">${p.category}</span></td>
                    <td class="text-end font-monospace price-cost-cell" data-raw-price="NT$ ${p.unitPrice.toFixed(2)}">NT$ ${p.unitPrice.toFixed(2)}</td>
                    <td>
                        <div class="d-flex align-items-center">
                            <span class="me-2 fw-bold font-monospace">${p.currentQty} 件</span>
                            ${p.onOrderQty > 0 ? `<span class="badge bg-purple-lt ms-1" title="已核准但尚未到貨之在途量"><i class="ti ti-truck-delivery me-1"></i>在途:${p.onOrderQty}</span>` : ''}
                            <div class="progress progress-sm flex-grow-1 ms-2" style="height: 6px;">
                                <div class="progress-bar ${progressColor}" style="width: ${ratio}%"></div>
                            </div>
                        </div>
                    </td>
                    <td class="text-center font-monospace text-muted">${p.safetyStock} 件</td>
                    <td class="text-center">${statusBadge}</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-success me-1" onclick="openStockModal('${p.id}', 'INBOUND')">
                            <i class="ti ti-plus"></i> 入庫
                        </button>
                        <button class="btn btn-sm btn-outline-danger me-1" onclick="openStockModal('${p.id}', 'OUTBOUND')">
                            <i class="ti ti-minus"></i> 出庫
                        </button>
                        <button class="btn btn-sm btn-outline-info role-manager-only" onclick="openStocktake('${p.id}', '${p.name.replace(/'/g, "\\'")}', ${p.currentQty})" data-bs-toggle="offcanvas" data-bs-target="#stocktakeDrawer" title="主管盤點校正">
                            <i class="ti ti-adjustments-alt"></i> 盤點
                        </button>
                    </td>
                </tr>`;
            });
            tbody.innerHTML = rows;
            applyRolePermissions();

        } catch (err) {
            console.error(err);
            tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-danger"><i class="ti ti-x me-1"></i>連線至資料庫失敗，請確認網路環境或 Supabase 狀態。</td></tr>`;
        }
    }

    // 2. 取得低於安全庫存商品 (呼叫 GET /api/v1/inventory/low-stock)
    async function loadLowStock() {
        const tbody = document.getElementById("lowStockTableBody");
        try {
            const res = await fetch("/api/v1/inventory/low-stock");
            if (!res.ok) throw new Error("讀取預警失敗");
            const data = await res.json();

            document.getElementById("kpiLowStockCount").innerText = data.length;

            if (data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-3 text-success"><i class="ti ti-circle-check me-1"></i>太棒了！目前所有商品庫存皆在安全水位以上，無需急迫採購。</td></tr>`;
                return;
            }

            let rows = "";
            data.forEach(p => {
                const suggestBuy = Math.max(10, (p.safetyStock * 2) - p.currentQty);
                rows += `
                <tr>
                    <td class="font-monospace text-danger fw-bold">${p.sku}</td>
                    <td>${p.name}</td>
                    <td class="font-monospace text-danger fw-bold">${p.currentQty} 件</td>
                    <td class="font-monospace text-muted">${p.safetyStock} 件</td>
                    <td class="font-monospace text-primary fw-semibold">+${suggestBuy} 件</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-success" onclick="openStockModal('${p.id}', 'INBOUND')">
                            <i class="ti ti-truck-loading me-1"></i>立即補貨
                        </button>
                    </td>
                </tr>`;
            });
            tbody.innerHTML = rows;
        } catch (err) {
            console.error(err);
        }
    }

    // 3. 處理新增商品 (POST /api/v1/products)
    async function handleCreateProduct(e) {
        e.preventDefault();
        const btn = document.getElementById("btnSaveProduct");
        btn.disabled = true;

        const payload = {
            sku: document.getElementById("prodSku").value.trim(),
            name: document.getElementById("prodName").value.trim(),
            category: document.getElementById("prodCategory").value,
            unitPrice: parseFloat(document.getElementById("prodPrice").value),
            safetyStock: parseInt(document.getElementById("prodSafety").value),
            initialStock: parseInt(document.getElementById("prodInitialStock").value) || 0
        };

        try {
            const res = await fetch("/api/v1/products", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                const errorData = await res.json();
                throw new Error(errorData.detail || "建立失敗");
            }

            // 關閉 Modal
            const modalEl = document.getElementById("productModal");
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();
            document.getElementById("createProductForm").reset();

            Toast.fire({
                icon: "success",
                title: "商品建立成功！已同步至 Supabase"
            });

            // 重新整理表格
            await refreshDashboard();

        } catch (err) {
            Swal.fire({
                icon: "error",
                title: "建立失敗",
                text: err.message
            });
        } finally {
            btn.disabled = false;
        }
    }

    // 4. 打開出入庫作業 Modal
    function openStockModal(productId, defaultType) {
        const prod = currentProductsList.find(p => p.id === productId);
        if (!prod) return;

        document.getElementById("stockProductId").value = prod.id;
        document.getElementById("stockModalProdName").innerText = prod.name;
        document.getElementById("stockModalProdSku").innerText = `SKU: ${prod.sku}`;
        document.getElementById("stockModalCurrentQty").innerText = `${prod.currentQty} 件`;

        // 設定 Radio
        const radio = document.querySelector(`input[name="movementType"][value="${defaultType}"]`);
        if (radio) {
            radio.checked = true;
            updateStockModalMode(defaultType);
        }

        document.getElementById("stockQty").value = "";
        document.getElementById("stockReason").value = "";

        const modal = new bootstrap.Modal(document.getElementById("stockModal"));
        modal.show();
    }

    function updateStockModalMode(type) {
        const btn = document.getElementById("btnSubmitStock");
        const hint = document.getElementById("stockQtyHint");
        if (type === "INBOUND") {
            btn.className = "btn btn-success ms-auto";
            btn.innerHTML = `<i class="ti ti-arrow-down-left me-1"></i>確認進貨入庫`;
            hint.innerText = "增加現有庫存量。";
        } else {
            btn.className = "btn btn-danger ms-auto";
            btn.innerHTML = `<i class="ti ti-arrow-up-right me-1"></i>確認銷貨出庫`;
            hint.innerText = "扣減庫存量（系統自動啟動防超賣檢查與資料庫交易）。";
        }
    }

    // 5. 提交出入庫異動 (呼叫 /api/v1/inventory/inbound 或 outbound)
    async function handleStockOperation(e) {
        e.preventDefault();
        const btn = document.getElementById("btnSubmitStock");
        btn.disabled = true;

        const productId = document.getElementById("stockProductId").value;
        const movementType = document.querySelector('input[name="movementType"]:checked').value;
        const quantity = parseInt(document.getElementById("stockQty").value);
        const reason = document.getElementById("stockReason").value.trim();
        const op = document.getElementById("stockOperator").value.trim() || "Warehouse_Staff";

        const endpoint = movementType === "INBOUND" ? "/api/v1/inventory/inbound" : "/api/v1/inventory/outbound";
        const payload = {
            productId: productId,
            quantity: quantity,
            reason: reason,
            operator: op
        };

        try {
            const res = await fetch(endpoint, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                const errorData = await res.json();
                throw new Error(errorData.detail || "操作失敗");
            }

            const data = await res.json();

            // 關閉 Modal
            const modalEl = document.getElementById("stockModal");
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();

            Toast.fire({
                icon: "success",
                title: movementType === "INBOUND"
                    ? `入庫成功！新庫存: ${data.newQty} 件`
                    : `出庫成功！剩餘庫存: ${data.newQty} 件`
            });

            await refreshDashboard();

        } catch (err) {
            Swal.fire({
                icon: "error",
                title: movementType === "OUTBOUND" ? "出庫被阻止 (防超賣保護)" : "作業失敗",
                text: err.message
            });
        } finally {
            btn.disabled = false;
        }
    }

    // ==========================================
    // 6. 右側抽屜業務邏輯：系統使用者管理 (User Drawer)
    // ==========================================
    async function loadUsersList() {
        const tbody = document.getElementById("userListTbody");
        tbody.innerHTML = `<tr><td colspan="3" class="text-center text-muted py-3"><span class="spinner-border spinner-border-sm me-1"></span>載入中...</td></tr>`;

        try {
            const res = await fetch("/api/v1/auth/users");
            if (!res.ok) throw new Error("讀取使用者清單失敗");
            const users = await res.json();

            if (users.length === 0) {
                tbody.innerHTML = `<tr><td colspan="3" class="text-center text-muted py-3">尚無自訂使用者</td></tr>`;
                return;
            }

            let html = "";
            users.forEach(u => {
                let badgeClass = "bg-secondary-lt";
                let roleName = u.role;
                if (u.role === "Admin") { badgeClass = "bg-red-lt"; roleName = "👑 管理員"; }
                else if (u.role === "Manager") { badgeClass = "bg-yellow-lt"; roleName = "👔 主管"; }
                else if (u.role === "Purchaser") { badgeClass = "bg-blue-lt"; roleName = "👤 採購"; }
                else if (u.role === "Warehouse") { badgeClass = "bg-green-lt"; roleName = "👷 倉管"; }

                html += `
                <tr>
                    <td>
                        <div class="fw-bold">${u.displayName}</div>
                        <div class="small text-secondary">${u.username}</div>
                    </td>
                    <td><span class="badge ${badgeClass}">${roleName}</span></td>
                    <td>
                        <span class="badge ${u.isActive ? "bg-success" : "bg-danger"} badge-dot me-1"></span>
                        <span class="small">${u.isActive ? "正常" : "停用"}</span>
                    </td>
                </tr>`;
            });
            tbody.innerHTML = html;
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="3" class="text-center text-danger py-3">${err.message}</td></tr>`;
        }
    }

    document.getElementById("formCreateUser")?.addEventListener("submit", async function (e) {
        e.preventDefault();
        const btn = document.getElementById("btnSubmitUser");
        btn.disabled = true;

        const payload = {
            username: document.getElementById("newUsername").value.trim(),
            displayName: document.getElementById("newDisplayName").value.trim(),
            password: document.getElementById("newPassword").value,
            role: document.getElementById("newRole").value
        };

        try {
            const res = await fetch("/api/v1/auth/register", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                const err = await res.json();
                throw new Error(err.detail || "建立失敗");
            }

            Toast.fire({ icon: "success", title: "使用者建立成功！" });
            document.getElementById("formCreateUser").reset();
            await loadUsersList();
        } catch (err) {
            Swal.fire({ icon: "error", title: "建立帳號失敗", text: err.message });
        } finally {
            btn.disabled = false;
        }
    });

    // ==========================================
    // 7. 右側抽屜業務邏輯：採購訂購單 (Purchase Drawer)
    // ==========================================
    async function loadPurchaseOrders() {
        const container = document.getElementById("poListContainer");
        container.innerHTML = `<div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-1"></span>載入採購單中...</div>`;

        // 同步填充下拉選單
        const select = document.getElementById("poProductSelect");
        if (select && currentProductsList.length > 0) {
            select.innerHTML = `<option value="">-- 請選擇欲採購的商品 --</option>` +
                currentProductsList.map(p => `<option value="${p.id}" data-price="${p.unitPrice}">${p.sku} - ${p.name} (在庫: ${p.currentQty})</option>`).join("");
            select.onchange = function() {
                const opt = select.selectedOptions[0];
                if (opt && opt.dataset.price) document.getElementById("poUnitPrice").value = opt.dataset.price;
            };
        }

        try {
            const res = await fetch("/api/v1/purchase-orders");
            if (!res.ok) throw new Error("讀取採購單失敗");
            const pos = await res.json();

            if (pos.length === 0) {
                container.innerHTML = `<div class="text-center text-muted py-4">目前尚無採購單，請填寫上方表單送審！</div>`;
                return;
            }

            let html = "";
            pos.forEach(po => {
                let statusBadge = "";
                let actionBtn = "";

                if (po.status === "Draft") {
                    statusBadge = `<span class="badge bg-secondary-lt">草稿 / 待審核</span>`;
                    actionBtn = `<button class="btn btn-sm btn-outline-success role-manager-only" onclick="approvePO('${po.id}')"><i class="ti ti-check me-1"></i>核准下單</button>`;
                } else if (po.status === "Approved") {
                    statusBadge = `<span class="badge bg-warning-lt">已核准 / 在途等貨</span>`;
                    actionBtn = `<button class="btn btn-sm btn-success" onclick="receiveAllPO('${po.id}')"><i class="ti ti-truck-delivery me-1"></i>到貨驗收入庫</button>`;
                } else if (po.status === "Completed") {
                    statusBadge = `<span class="badge bg-success-lt">已全數到貨結案</span>`;
                    actionBtn = `<span class="text-muted small"><i class="ti ti-circle-check text-success"></i> 結案完成</span>`;
                }

                let itemsHtml = po.items.map(i => `
                    <div class="d-flex justify-content-between small text-secondary py-1 border-bottom border-light">
                        <span>${i.productName} (${i.sku})</span>
                        <span>訂: ${i.orderedQty} | 已收: <strong class="text-dark">${i.receivedQty}</strong> | NT$ ${i.unitPrice}</span>
                    </div>
                `).join("");

                html += `
                <div class="card mb-3 shadow-none border">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <span class="fw-bold font-monospace text-primary">${po.poNumber}</span>
                                <span class="ms-2 text-dark">${po.supplierName}</span>
                            </div>
                            <div>${statusBadge}</div>
                        </div>
                        <div class="bg-light p-2 rounded mb-2">${itemsHtml}</div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="small text-muted">總金額: <strong class="text-dark">NT$ ${po.totalAmount.toLocaleString()}</strong> &bull; 建單: ${po.createdBy}</span>
                            <div>${actionBtn}</div>
                        </div>
                    </div>
                </div>`;
            });

            container.innerHTML = html;
            applyRolePermissions();
        } catch (err) {
            container.innerHTML = `<div class="text-center text-danger py-4">${err.message}</div>`;
        }
    }

    document.getElementById("formCreatePO")?.addEventListener("submit", async function (e) {
        e.preventDefault();
        const btn = document.getElementById("btnSubmitPO");
        btn.disabled = true;

        const prodId = document.getElementById("poProductSelect").value;
        const qty = parseInt(document.getElementById("poQuantity").value);
        const price = parseFloat(document.getElementById("poUnitPrice").value);

        if (!prodId) {
            Swal.fire({ icon: "warning", title: "請先選擇採購商品" });
            btn.disabled = false;
            return;
        }

        const payload = {
            supplierName: document.getElementById("poSupplier").value.trim(),
            remark: document.getElementById("poRemark").value.trim(),
            createdBy: window.currentUserName || "Purchaser",
            items: [{ productId: prodId, orderedQty: qty, unitPrice: price }]
        };

        try {
            const res = await fetch("/api/v1/purchase-orders", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                const err = await res.json();
                throw new Error(err.detail || "採購單建立失敗");
            }

            Toast.fire({ icon: "success", title: "採購單草稿建立成功！" });
            document.getElementById("formCreatePO").reset();
            await loadPurchaseOrders();
        } catch (err) {
            Swal.fire({ icon: "error", title: "建立採購單失敗", text: err.message });
        } finally {
            btn.disabled = false;
        }
    });

    async function approvePO(id) {
        const confirm = await Swal.fire({
            title: "確認審核核准此採購單？",
            text: "核准後系統將自動將商品累加至「在途量 (On-Order)」，並可進行到貨驗收入庫。",
            icon: "question",
            showCancelButton: true,
            confirmButtonText: "確認核准",
            cancelButtonText: "取消"
        });

        if (!confirm.isConfirmed) return;

        try {
            const res = await fetch(`/api/v1/purchase-orders/${id}/approve?approvedBy=${encodeURIComponent(window.currentUserName || "Manager")}`, {
                method: "POST"
            });
            if (!res.ok) throw new Error("審核失敗");

            Toast.fire({ icon: "success", title: "採購單已核准！在途量已自動累加" });
            await loadPurchaseOrders();
            await refreshDashboard();
        } catch (err) {
            Swal.fire({ icon: "error", title: "審核失敗", text: err.message });
        }
    }

    async function receiveAllPO(poId) {
        try {
            const poRes = await fetch(`/api/v1/purchase-orders/${poId}`);
            const po = await poRes.json();

            const itemsToReceive = po.items
                .filter(i => i.orderedQty > i.receivedQty)
                .map(i => ({ itemId: i.id, quantity: i.orderedQty - i.receivedQty }));

            if (itemsToReceive.length === 0) {
                Toast.fire({ icon: "info", title: "此採購單商品已全數到齊" });
                return;
            }

            const confirm = await Swal.fire({
                title: "確認到貨驗收入庫？",
                text: `將扣減在途量並增加在庫現有庫存。`,
                icon: "info",
                showCancelButton: true,
                confirmButtonText: "確認驗收",
                cancelButtonText: "取消"
            });

            if (!confirm.isConfirmed) return;

            const res = await fetch("/api/v1/purchase-orders/receive", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    purchaseOrderId: poId,
                    items: itemsToReceive,
                    operator: window.currentUserName || "Warehouse"
                })
            });

            if (!res.ok) throw new Error("驗收失敗");

            Toast.fire({ icon: "success", title: "到貨驗收完成！庫存已增加，在途量已扣減" });
            await loadPurchaseOrders();
            await refreshDashboard();
        } catch (err) {
            Swal.fire({ icon: "error", title: "驗收失敗", text: err.message });
        }
    }

    // ==========================================
    // 8. 右側抽屜業務邏輯：盤點校正與流水帳 (Stocktake Drawer)
    // ==========================================
    async function openStocktake(productId, productName, currentQty) {
        document.getElementById("stocktakeProductId").value = productId;
        document.getElementById("stocktakeProductName").value = productName;
        document.getElementById("stocktakeCurrentQty").value = currentQty;
        document.getElementById("stocktakeActualQty").value = currentQty;
        document.getElementById("stocktakeReason").value = "";

        // 載入歷史異動流水帳
        const historyContainer = document.getElementById("stockMovementHistory");
        historyContainer.innerHTML = `<div class="text-center text-muted py-3"><span class="spinner-border spinner-border-sm me-1"></span>載入歷史流水帳中...</div>`;

        try {
            const res = await fetch(`/api/v1/inventory/${productId}/movements`);
            if (!res.ok) throw new Error("讀取流水帳失敗");
            const movements = await res.json();

            if (movements.length === 0) {
                historyContainer.innerHTML = `<div class="text-center text-muted py-3">暫無異動歷程</div>`;
                return;
            }

            let html = '<div class="timeline">';
            movements.forEach(m => {
                let badge = m.movementType === "INBOUND"
                    ? `<span class="badge bg-success-lt">+${m.quantity} 進貨</span>`
                    : (m.movementType === "OUTBOUND" ? `<span class="badge bg-danger-lt">${m.quantity} 出庫</span>` : `<span class="badge bg-info-lt">${m.quantity > 0 ? "+" : ""}${m.quantity} 盤點</span>`);

                const timeStr = new Date(m.createdAt).toLocaleString("zh-TW", { hour12: false });
                html += `
                <div class="border-bottom py-2 small">
                    <div class="d-flex justify-content-between">
                        <strong>${badge}</strong>
                        <span class="text-secondary">${timeStr}</span>
                    </div>
                    <div class="mt-1 text-secondary">
                        異動前: ${m.previousQty} &rarr; 異動後: <strong>${m.newQty}</strong> &bull; 人員: ${m.operator}
                    </div>
                    <div class="text-muted mt-1"><i class="ti ti-notes me-1"></i>${m.reason || "無說明"}</div>
                </div>`;
            });
            html += '</div>';
            historyContainer.innerHTML = html;
        } catch (err) {
            historyContainer.innerHTML = `<div class="text-danger py-3 text-center">${err.message}</div>`;
        }
    }

    document.getElementById("formStocktake")?.addEventListener("submit", async function (e) {
        e.preventDefault();
        const btn = document.getElementById("btnSubmitStocktake");
        btn.disabled = true;

        const prodId = document.getElementById("stocktakeProductId").value;
        const actualQty = parseInt(document.getElementById("stocktakeActualQty").value);
        const reason = document.getElementById("stocktakeReason").value.trim();

        try {
            const res = await fetch("/api/v1/inventory/stocktake", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    productId: prodId,
                    actualQty: actualQty,
                    reason: reason,
                    operator: window.currentUserName || "Manager"
                })
            });

            if (!res.ok) {
                const err = await res.json();
                throw new Error(err.detail || "校正失敗");
            }

            Toast.fire({ icon: "success", title: "盤點校正成功！庫存已更新" });
            const drawerEl = document.getElementById("stocktakeDrawer");
            const drawer = bootstrap.Offcanvas.getInstance(drawerEl);
            if (drawer) drawer.hide();

            await refreshDashboard();
        } catch (err) {
            Swal.fire({ icon: "error", title: "盤點校正失敗", text: err.message });
        } finally {
            btn.disabled = false;
        }
    });
</script>
}

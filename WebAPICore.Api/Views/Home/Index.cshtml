    function openStocktakeDrawer(productId, productName, currentQty) {
        document.getElementById("stocktakeProductId").value = productId;
        document.getElementById("stocktakeProductName").value = productName;
        document.getElementById("stocktakeCurrentQty").value = currentQty;
        document.getElementById("stocktakeActualQty").value = currentQty;
        document.getElementById("stocktakeReason").value = "";

        // 載入異動流水帳
        const historyContainer = document.getElementById("stockMovementHistory");
        historyContainer.innerHTML = `<div class="text-center text-muted py-3"><span class="spinner-border spinner-border-sm me-1"></span>載入歷史流水帳中...</div>`;

        fetch(`/api/v1/inventory/${productId}/movements`)
            .then(res => res.json())
            .then(movements => {
                if (movements.length === 0) {
                    historyContainer.innerHTML = `<div class="text-center text-muted py-3">暫無異動歷程</div>`;
                    return;
                }
                let html = '<div class="timeline">';
                movements.forEach(m => {
                    let badge = m.movementType === "INBOUND"
                        ? `<span class="badge bg-success-lt">+${m.quantity} 進貨</span>`
                        : (m.movementType === "OUTBOUND" ? `<span class="badge bg-danger-lt">${m.quantity} 出庫</span>` : `<span class="badge bg-info-lt">${m.quantity > 0 ? "+" : ""}${m.quantity} 盤點</span>`);
                    const timeStr = new Date(m.createdAt).toLocaleString("zh-TW", { hour12: false });
                    html += `
                    <div class="border-bottom py-2 small">
                        <div class="d-flex justify-content-between">
                            <strong>${badge}</strong>
                            <span class="text-secondary">${timeStr}</span>
                        </div>
                        <div class="mt-1 text-secondary">
                            異動前: ${m.previousQty} &rarr; 異動後: <strong>${m.newQty}</strong> &bull; 人員: ${m.operator}
                        </div>
                        <div class="text-muted mt-1"><i class="ti ti-notes me-1"></i>${m.reason || "無說明"}</div>
                    </div>`;
                });
                html += '</div>';
                historyContainer.innerHTML = html;
            })
            .catch(err => {
                historyContainer.innerHTML = `<div class="text-danger py-3 text-center">${err.message}</div>`;
            });

        const drawerEl = document.getElementById("stocktakeDrawer");
        const drawer = new bootstrap.Offcanvas(drawerEl);
        drawer.show();
    }

    // ==========================================
    // 8. 業務表單提交處理 (AJAX & Toast)
    // ==========================================
    let cachedPoProducts = [];

    async function loadSuppliersForPO() {
        const select = document.getElementById("poSupplierSelect");
        if (!select) return;
        try {
            const res = await fetch("/api/v1/suppliers?activeOnly=true");
            if (!res.ok) return;
            const suppliers = await res.json();
            cachedSuppliers = suppliers;
            let html = `<option value="">-- 請選擇合作供應商 --</option>`;
            suppliers.forEach(s => {
                html += `<option value="${s.id}" data-name="${s.name}">[${s.code}] ${s.name} (${s.contactPerson})</option>`;
            });
            select.innerHTML = html;
        } catch (e) {
            console.error(e);
        }
    }

    // 採購單：選定供應商後連動過濾商品清單 (Cascading Filter)
    async function onPoSupplierChanged() {
        const supId = document.getElementById("poSupplierSelect")?.value;
        const prodSelect = document.getElementById("poProductSelect");
        const priceInput = document.getElementById("poUnitPrice");
        if (!prodSelect) return;

        if (!supId) {
            prodSelect.innerHTML = `<option value="">-- 請先選擇供應商 --</option>`;
            prodSelect.disabled = true;
            if (priceInput) priceInput.value = "";
            cachedPoProducts = [];
            return;
        }

        prodSelect.disabled = false;
        prodSelect.innerHTML = `<option value="">載入供應商商品中...</option>`;

        try {
            // 查詢該供應商所屬商品
            const res = await fetch(`/api/v1/products?supplierId=${supId}&pageSize=100`);
            if (!res.ok) throw new Error("讀取商品失敗");
            const data = await res.json();
            cachedPoProducts = data.items;

            if (cachedPoProducts.length === 0) {
                prodSelect.innerHTML = `<option value="">(此供應商目前尚無綁定商品，可至商品主檔指定)</option>`;
                if (priceInput) priceInput.value = "";
                return;
            }

            let html = `<option value="">-- 請選擇採購商品 (${cachedPoProducts.length} 項供貨) --</option>`;
            cachedPoProducts.forEach(p => {
                html += `<option value="${p.id}" data-price="${p.unitPrice}">[${p.sku}] ${p.name} (預設進價: NT$ ${p.unitPrice})</option>`;
            });
            prodSelect.innerHTML = html;
            if (priceInput) priceInput.value = "";
        } catch (err) {
            prodSelect.innerHTML = `<option value="">載入失敗: ${err.message}</option>`;
        }
    }

    // 採購單：選擇商品後自動帶入預設單價
    function onPoProductChanged() {
        const prodSelect = document.getElementById("poProductSelect");
        const priceInput = document.getElementById("poUnitPrice");
        if (!prodSelect || !priceInput) return;

        const opt = prodSelect.selectedOptions[0];
        if (opt && opt.dataset.price) {
            priceInput.value = parseFloat(opt.dataset.price).toFixed(2);
        } else {
            priceInput.value = "";
        }
    }

    // 建立或編輯供應商
    document.getElementById("formCreateSupplier")?.addEventListener("submit", async function (e) {
        e.preventDefault();
        const btn = document.getElementById("btnSubmitSupplier");
        btn.disabled = true;

        const editId = document.getElementById("editSupplierId").value;
        const isEdit = !!editId;

        const payload = isEdit ? {
            name: document.getElementById("newSupName").value.trim(),
            contactPerson: document.getElementById("newSupContact").value.trim(),
            phone: document.getElementById("newSupPhone").value.trim(),
            email: document.getElementById("newSupEmail").value.trim() || null,
            address: document.getElementById("newSupAddress").value.trim() || null
        } : {
            code: document.getElementById("newSupCode").value.trim().toUpperCase(),
            name: document.getElementById("newSupName").value.trim(),
            contactPerson: document.getElementById("newSupContact").value.trim(),
            phone: document.getElementById("newSupPhone").value.trim(),
            email: document.getElementById("newSupEmail").value.trim() || null,
            address: document.getElementById("newSupAddress").value.trim() || null
        };

        const url = isEdit ? `/api/v1/suppliers/${editId}` : "/api/v1/suppliers";
        const method = isEdit ? "PUT" : "POST";

        try {
            const res = await fetch(url, {
                method: method,
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });
            if (!res.ok) {
                const err = await res.json();
                throw new Error(err.detail || (isEdit ? "更新供應商失敗" : "建立供應商失敗"));
            }
            Toast.fire({ icon: "success", title: isEdit ? "供應商資料已更新！" : "供應商建立成功！" });
            document.getElementById("formCreateSupplier").reset();
            document.getElementById("editSupplierId").value = "";
            const drawerEl = document.getElementById("supplierDrawer");
            const drawer = bootstrap.Offcanvas.getInstance(drawerEl);
            if (drawer) drawer.hide();

            loadSuppliersTable();
            loadSuppliersForPO();
        } catch (err) {
            Swal.fire({ icon: "error", title: isEdit ? "更新失敗" : "建立失敗", text: err.message });
        } finally {
            btn.disabled = false;
        }
    });

    async function toggleSupplierStatus(id) {
        try {
            const res = await fetch(`/api/v1/suppliers/${id}/toggle-active`, { method: "POST" });
            if (!res.ok) throw new Error("更新供應商狀態失敗");
            Toast.fire({ icon: "success", title: "供應商合作狀態已更新！" });
            loadSuppliersTable();
            loadSuppliersForPO();
        } catch (err) {
            Swal.fire({ icon: "error", title: "操作失敗", text: err.message });
        }
    }

    // 建立採購單
    document.getElementById("formCreatePO")?.addEventListener("submit", async function (e) {
        e.preventDefault();
        const btn = document.getElementById("btnSubmitPO");
        btn.disabled = true;

        const supSelect = document.getElementById("poSupplierSelect");
        const supId = supSelect.value;
        const supName = supSelect.selectedOptions[0]?.dataset.name || supSelect.selectedOptions[0]?.text;
        const prodId = document.getElementById("poProductSelect").value;
        const qty = parseInt(document.getElementById("poQuantity").value);
        const price = parseFloat(document.getElementById("poUnitPrice").value);

        if (!supId) {
            Swal.fire({ icon: "warning", title: "請先選擇合作供應商" });
            btn.disabled = false;
            return;
        }
        if (!prodId) {
            Swal.fire({ icon: "warning", title: "請先選擇採購商品" });
            btn.disabled = false;
            return;
        }

        const payload = {
            supplierId: supId,
            supplierName: supName,
            department: window.currentUserDept || "總務課",
            remark: document.getElementById("poRemark").value.trim(),
            createdBy: window.currentUserName || "Purchaser",
            items: [{ productId: prodId, orderedQty: qty, unitPrice: price }]
        };

        try {
            const res = await fetch("/api/v1/purchase-orders", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });
            if (!res.ok) {
                const err = await res.json();
                throw new Error(err.detail || "採購單建立失敗");
            }
            Toast.fire({ icon: "success", title: "採購單草稿建立成功！" });
            document.getElementById("formCreatePO").reset();
            const drawerEl = document.getElementById("purchaseDrawer");
            const drawer = bootstrap.Offcanvas.getInstance(drawerEl);
            if (drawer) drawer.hide();

            loadPurchaseOrdersTable();
            refreshDashboard();
        } catch (err) {
            Swal.fire({ icon: "error", title: "建立採購單失敗", text: err.message });
        } finally {
            btn.disabled = false;
        }
    });

    async function approvePO(id) {
        const confirm = await Swal.fire({
            title: "確認審核核准此採購單？",
            text: "核准後系統將自動將商品累加至「在途量 (On-Order)」，並可進行到貨驗收入庫。",
            icon: "question",
            showCancelButton: true,
            confirmButtonText: "確認核准",
            cancelButtonText: "取消"
        });
        if (!confirm.isConfirmed) return;

        try {
            const res = await fetch(`/api/v1/purchase-orders/${id}/approve?approvedBy=${encodeURIComponent(window.currentUserName || "Manager")}`, {
                method: "POST"
            });
            if (!res.ok) throw new Error("審核失敗");
            Toast.fire({ icon: "success", title: "採購單已核准！在途量已累加" });
            loadPurchaseOrdersTable();
            refreshDashboard();
        } catch (err) {
            Swal.fire({ icon: "error", title: "審核失敗", text: err.message });
        }
    }

    async function receiveAllPO(poId) {
        try {
            const poRes = await fetch(`/api/v1/purchase-orders/${poId}`);
            const po = await poRes.json();
            const itemsToReceive = po.items
                .filter(i => i.orderedQty > i.receivedQty)
                .map(i => ({ itemId: i.id, quantity: i.orderedQty - i.receivedQty }));

            if (itemsToReceive.length === 0) {
                Toast.fire({ icon: "info", title: "此採購單商品已全數到齊" });
                return;
            }

            const confirm = await Swal.fire({
                title: "確認到貨驗收入庫？",
                text: `將扣減在途量並增加現有庫存。`,
                icon: "info",
                showCancelButton: true,
                confirmButtonText: "確認驗收",
                cancelButtonText: "取消"
            });
            if (!confirm.isConfirmed) return;

            const res = await fetch("/api/v1/purchase-orders/receive", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    purchaseOrderId: poId,
                    items: itemsToReceive,
                    operator: window.currentUserName || "Warehouse"
                })
            });
            if (!res.ok) throw new Error("驗收失敗");
            Toast.fire({ icon: "success", title: "到貨驗收完成！庫存已增加，在途量已扣減" });
            loadPurchaseOrdersTable();
            refreshDashboard();
        } catch (err) {
            Swal.fire({ icon: "error", title: "驗收失敗", text: err.message });
        }
    }

    // 建立新使用者
    document.getElementById("formCreateUser")?.addEventListener("submit", async function (e) {
        e.preventDefault();
        const btn = document.getElementById("btnSubmitUser");
        btn.disabled = true;

        const payload = {
            username: document.getElementById("newUsername").value.trim(),
            displayName: document.getElementById("newDisplayName").value.trim(),
            password: document.getElementById("newPassword").value,
            role: document.getElementById("newRole").value,
            department: document.getElementById("newDepartment").value.trim() || "總務課"
        };

        try {
            const res = await fetch("/api/v1/auth/register", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });
            if (!res.ok) {
                const err = await res.json();
                throw new Error(err.detail || "建立失敗");
            }
            Toast.fire({ icon: "success", title: "使用者建立成功！" });
            document.getElementById("formCreateUser").reset();
            document.getElementById("newDepartment").value = "總務課";
            const drawerEl = document.getElementById("userDrawer");
            const drawer = bootstrap.Offcanvas.getInstance(drawerEl);
            if (drawer) drawer.hide();

            loadUsersTable();
        } catch (err) {
            Swal.fire({ icon: "error", title: "建立帳號失敗", text: err.message });
        } finally {
            btn.disabled = false;
        }
    });

    // 盤點校正
    document.getElementById("formStocktake")?.addEventListener("submit", async function (e) {
        e.preventDefault();
        const btn = document.getElementById("btnSubmitStocktake");
        btn.disabled = true;

        const prodId = document.getElementById("stocktakeProductId").value;
        const actualQty = parseInt(document.getElementById("stocktakeActualQty").value);
        const reason = document.getElementById("stocktakeReason").value.trim();

        try {
            const res = await fetch("/api/v1/inventory/stocktake", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    productId: prodId,
                    actualQty: actualQty,
                    reason: reason,
                    operator: window.currentUserName || "Manager"
                })
            });
            if (!res.ok) {
                const err = await res.json();
                throw new Error(err.detail || "校正失敗");
            }
            Toast.fire({ icon: "success", title: "盤點校正成功！庫存已更新" });
            const drawerEl = document.getElementById("stocktakeDrawer");
            const drawer = bootstrap.Offcanvas.getInstance(drawerEl);
            if (drawer) drawer.hide();

            loadProducts();
            refreshDashboard();
        } catch (err) {
            Swal.fire({ icon: "error", title: "盤點校正失敗", text: err.message });
        } finally {
            btn.disabled = false;
        }
    });

    // 出入庫作業 Modal 打開
    function openStockModal(productId, defaultType) {
        const prod = currentProductsList.find(p => p.id === productId);
        if (!prod) return;
        document.getElementById("stockProductId").value = prod.id;
        document.getElementById("stockModalProdName").innerText = prod.name;
        document.getElementById("stockModalProdSku").innerText = `SKU: ${prod.sku}`;
        document.getElementById("stockModalCurrentQty").innerText = `${prod.currentQty} 件`;

        const radio = document.querySelector(`input[name="movementType"][value="${defaultType}"]`);
        if (radio) {
            radio.checked = true;
            updateStockModalMode(defaultType);
        }
        document.getElementById("stockQty").value = "";
        document.getElementById("stockReason").value = "";
        const modal = new bootstrap.Modal(document.getElementById("stockModal"));
        modal.show();
    }

    function updateStockModalMode(type) {
        const btn = document.getElementById("btnSubmitStock");
        const hint = document.getElementById("stockQtyHint");
        if (type === "INBOUND") {
            btn.className = "btn btn-success ms-auto";
            btn.innerHTML = `<i class="ti ti-arrow-down-left me-1"></i>確認進貨入庫`;
            hint.innerText = "增加現有庫存量。";
        } else {
            btn.className = "btn btn-danger ms-auto";
            btn.innerHTML = `<i class="ti ti-arrow-up-right me-1"></i>確認銷貨出庫`;
            hint.innerText = "扣減庫存量（系統自動啟動防超賣檢查與資料庫交易）。";
        }
    }

    async function handleStockOperation(e) {
        e.preventDefault();
        const btn = document.getElementById("btnSubmitStock");
        btn.disabled = true;

        const productId = document.getElementById("stockProductId").value;
        const movementType = document.querySelector('input[name="movementType"]:checked').value;
        const quantity = parseInt(document.getElementById("stockQty").value);
        const reason = document.getElementById("stockReason").value.trim();
        const op = document.getElementById("stockOperator").value.trim() || window.currentUserName || "Warehouse_Staff";

        const endpoint = movementType === "INBOUND" ? "/api/v1/inventory/inbound" : "/api/v1/inventory/outbound";
        const payload = { productId, quantity, reason, operator: op };

        try {
            const res = await fetch(endpoint, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });
            if (!res.ok) {
                const errorData = await res.json();
                throw new Error(errorData.detail || "操作失敗");
            }
            const data = await res.json();
            const modalEl = document.getElementById("stockModal");
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();

            Toast.fire({
                icon: "success",
                title: movementType === "INBOUND"
                    ? `入庫成功！新庫存: ${data.newQty} 件`
                    : `出庫成功！剩餘庫存: ${data.newQty} 件`
            });
            loadProducts();
            refreshDashboard();
        } catch (err) {
            Swal.fire({
                icon: "error",
                title: movementType === "OUTBOUND" ? "出庫被阻止 (防超賣保護)" : "作業失敗",
                text: err.message
            });
        } finally {
            btn.disabled = false;
        }
    }

    async function handleProductFormSubmit(e) {
        e.preventDefault();
        const btn = document.getElementById("btnSaveProduct");
        btn.disabled = true;

        const editId = document.getElementById("editProductId").value;
        const isEdit = !!editId;

        const supVal = document.getElementById("prodSupplier").value;
        const supplierId = supVal ? supVal : null;

        const payload = isEdit ? {
            name: document.getElementById("prodName").value.trim(),
            category: document.getElementById("prodCategory").value,
            unitPrice: parseFloat(document.getElementById("prodPrice").value),
            safetyStock: parseInt(document.getElementById("prodSafety").value),
            supplierId: supplierId
        } : {
            sku: document.getElementById("prodSku").value.trim(),
            name: document.getElementById("prodName").value.trim(),
            category: document.getElementById("prodCategory").value,
            unitPrice: parseFloat(document.getElementById("prodPrice").value),
            safetyStock: parseInt(document.getElementById("prodSafety").value),
            initialStock: parseInt(document.getElementById("prodInitialStock").value) || 0,
            supplierId: supplierId
        };

        const url = isEdit ? `/api/v1/products/${editId}` : "/api/v1/products";
        const method = isEdit ? "PUT" : "POST";

        try {
            const res = await fetch(url, {
                method: method,
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });
            if (!res.ok) {
                const errorData = await res.json();
                throw new Error(errorData.detail || (isEdit ? "更新商品失敗" : "建立商品失敗"));
            }
            const modalEl = document.getElementById("productModal");
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();
            document.getElementById("createProductForm").reset();
            document.getElementById("editProductId").value = "";

            Toast.fire({ icon: "success", title: isEdit ? "商品資料已更新！" : "商品建立成功！已同步至 Supabase" });
            loadProducts();
            refreshDashboard();
        } catch (err) {
            Swal.fire({ icon: "error", title: isEdit ? "更新失敗" : "建立失敗", text: err.message });
        } finally {
            btn.disabled = false;
        }
    }
</script>
}

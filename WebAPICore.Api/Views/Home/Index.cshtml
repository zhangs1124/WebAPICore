@{
    ViewData["Title"] = "企業級進銷存管理";
}

<!-- ======================================================== -->
<!-- 視圖 1：營運總覽儀表板 (View: Dashboard) -->
<!-- ======================================================== -->
<div id="view-dashboard" class="erp-view">
    <!-- 4 欄式 KPI 營運指標卡 (Metric Strips) -->
    <div class="row row-deck row-cards mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="bg-primary text-white avatar fs-2">
                                <i class="ti ti-box"></i>
                            </span>
                        </div>
                        <div class="col">
                            <div class="font-weight-medium text-secondary small">商品總品項數</div>
                            <div class="text-reset fw-bold fs-1" id="kpiTotalProducts">0</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="bg-green text-white avatar fs-2">
                                <i class="ti ti-packages"></i>
                            </span>
                        </div>
                        <div class="col">
                            <div class="font-weight-medium text-secondary small">在庫現存總件數</div>
                            <div class="text-reset fw-bold fs-1" id="kpiTotalStock">0</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="bg-warning text-white avatar fs-2">
                                <i class="ti ti-alert-triangle"></i>
                            </span>
                        </div>
                        <div class="col">
                            <div class="font-weight-medium text-secondary small">安全庫存警戒數</div>
                            <div class="text-reset fw-bold fs-1" id="kpiLowStockCount">0</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="bg-purple text-white avatar fs-2">
                                <i class="ti ti-server"></i>
                            </span>
                        </div>
                        <div class="col">
                            <div class="font-weight-medium text-secondary small">雲端資料庫狀態</div>
                            <div class="text-reset fw-bold fs-2 text-success">
                                <span class="status-dot status-dot-animated bg-green me-1"></span>正常
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 儀表板快速跳轉與概覽 -->
    <div class="row row-cards">
        <div class="col-md-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title fw-bold"><i class="ti ti-bell-ringing text-warning me-2"></i>即時庫存警戒摘要</h3>
                    <button class="btn btn-sm btn-link text-decoration-none" onclick="switchView('low-stock')">查看完整預警 &rarr;</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-sm">
                        <thead>
                            <tr>
                                <th>SKU</th>
                                <th>商品名稱</th>
                                <th>現存數量</th>
                                <th>安全水位</th>
                                <th class="text-end">動作</th>
                            </tr>
                        </thead>
                        <tbody id="dashLowStockTbody">
                            <tr><td colspan="5" class="text-center text-muted py-3">載入中...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title fw-bold"><i class="ti ti-truck-delivery text-primary me-2"></i>最新採購與在途追蹤</h3>
                    <button class="btn btn-sm btn-link text-decoration-none role-purchaser-only" onclick="switchView('purchases')">完整採購單 &rarr;</button>
                </div>
                <div class="card-body p-3" id="dashPoSummaryContainer">
                    <div class="text-center text-muted py-3">載入中...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- 視圖 2：商品即時庫存完整大表 (View: Products) -->
<!-- ======================================================== -->
<div id="view-products" class="erp-view d-none">
    <div class="card border-0 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h3 class="card-title fw-bold m-0"><i class="ti ti-box text-primary me-2"></i>商品即時庫存總表</h3>
                <div class="text-muted small">即時掌握現有量、在途進貨量與安全庫存防線</div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <input type="text" id="filterSearch" class="form-control form-control-sm" placeholder="搜尋 SKU 或品名..." style="width: 200px;" onkeyup="handleFilterKey(event)">
                <select id="filterCategory" class="form-select form-select-sm" style="width: 130px;" onchange="loadProducts()">
                    <option value="">全部類別</option>
                    <option value="電腦周邊">電腦周邊</option>
                    <option value="辦公設備">辦公設備</option>
                    <option value="生活家電">生活家電</option>
                    <option value="耗材配件">耗材配件</option>
                </select>
                <button class="btn btn-sm btn-primary" onclick="loadProducts()">
                    <i class="ti ti-search me-1"></i>查詢
                </button>
                <button type="button" class="btn btn-sm btn-success" onclick="openCreateProductModal()">
                    <i class="ti ti-plus me-1"></i>新增商品
                </button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th>商品貨號 (SKU)</th>
                        <th>商品名稱</th>
                        <th>分類</th>
                        <th>主要供應商</th>
                        <th class="text-end">銷售單價</th>
                        <th style="min-width: 180px;">現有庫存 / 在途採購</th>
                        <th class="text-center">安全庫存線</th>
                        <th class="text-center">庫存狀態</th>
                        <th class="text-end">快速操作</th>
                    </tr>
                </thead>
                <tbody id="productsTableBody">
                    <tr><td colspan="9" class="text-center py-4 text-muted">正在載入商品數據...</td></tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer d-flex align-items-center py-2">
            <p class="m-0 text-secondary small" id="paginationInfo">共 0 筆商品品項</p>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- 視圖 3：安全庫存警戒專區 (View: Low Stock) -->
<!-- ======================================================== -->
<div id="view-low-stock" class="erp-view d-none">
    <div class="card border-0 shadow-sm border-start border-warning border-3">
        <div class="card-header bg-warning-lt d-flex justify-content-between align-items-center">
            <div>
                <h3 class="card-title text-warning fw-bold m-0"><i class="ti ti-bell-ringing me-2"></i>急需補貨商品警戒區 (現有庫存 &le; 安全庫存)</h3>
                <div class="text-muted small">系統自動試算補貨量，可立即開立請購單採購補充</div>
            </div>
            <button class="btn btn-sm btn-outline-warning" onclick="loadLowStock()">
                <i class="ti ti-refresh me-1"></i>重新整理
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>商品貨號 (SKU)</th>
                        <th>品名</th>
                        <th>現存數量</th>
                        <th>安全警戒線</th>
                        <th>建議採購補貨量</th>
                        <th class="text-end">快速作業</th>
                    </tr>
                </thead>
                <tbody id="lowStockTableBody">
                    <tr><td colspan="6" class="text-center text-muted py-4">載入預警數據中...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- 視圖 4：採購訂購單管理完整大表 (View: Purchases) -->
<!-- ======================================================== -->
<div id="view-purchases" class="erp-view d-none">
    <div class="card border-0 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h3 class="card-title fw-bold m-0"><i class="ti ti-shopping-cart text-warning me-2"></i>採購訂購單管理大表 (PO)</h3>
                <div class="text-muted small">二合一請購訂購、主管線上審批、在庫在途聯動與貨到驗收入庫</div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <!-- 部門篩選 (主管/Admin 專用) -->
                <select class="form-select form-select-sm role-manager-only" id="filterPoDepartment" style="width: 130px;" onchange="loadPurchaseOrdersTable()">
                    <option value="">全部部門</option>
                    <option value="總務課">總務課</option>
                    <option value="資材部">資材部</option>
                    <option value="製造部">製造部</option>
                    <option value="營運處">營運處</option>
                    <option value="資訊部">資訊部</option>
                </select>
                <select class="form-select form-select-sm" id="filterPoStatus" style="width: 120px;" onchange="loadPurchaseOrdersTable()">
                    <option value="">全部狀態</option>
                    <option value="Draft">草稿 / 待審</option>
                    <option value="Approved">已核准在途</option>
                    <option value="Completed">已全到結案</option>
                </select>
                <button class="btn btn-sm btn-outline-secondary" onclick="loadPurchaseOrdersTable()">
                    <i class="ti ti-refresh me-1"></i>刷新
                </button>
                <button type="button" class="btn btn-sm btn-warning fw-bold text-dark role-purchaser-only" onclick="openCreatePODrawer()">
                    <i class="ti ti-plus me-1"></i>建立採購單
                </button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th>採購單號 (PO)</th>
                        <th>請購部門</th>
                        <th>合作供應商</th>
                        <th>採購品項與進度</th>
                        <th class="text-end">採購總額</th>
                        <th class="text-center">狀態</th>
                        <th>建單人 / 日期</th>
                        <th class="text-end">操作處理</th>
                    </tr>
                </thead>
                <tbody id="poTableBody">
                    <tr><td colspan="8" class="text-center py-4 text-muted">載入採購單數據中...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- 視圖 5：供應商主檔資料維護完整大表 (View: Suppliers) -->
<!-- ======================================================== -->
<div id="view-suppliers" class="erp-view d-none">
    <div class="card border-0 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h3 class="card-title fw-bold m-0"><i class="ti ti-building-store text-info me-2"></i>供應商主檔資料維護</h3>
                <div class="text-muted small">廠商代碼、聯絡窗口、電話地址維護，採購開單自動帶入</div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <select class="form-select form-select-sm" id="filterSupStatus" style="width: 120px;" onchange="loadSuppliersTable()">
                    <option value="">全部狀態</option>
                    <option value="true">合作中</option>
                    <option value="false">暫停合作</option>
                </select>
                <button class="btn btn-sm btn-outline-secondary" onclick="loadSuppliersTable()">
                    <i class="ti ti-refresh me-1"></i>刷新
                </button>
                <button type="button" class="btn btn-sm btn-info text-white fw-bold role-purchaser-only" onclick="openCreateSupplierDrawer()">
                    <i class="ti ti-plus me-1"></i>新增供應商
                </button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th>供應商代碼</th>
                        <th>公司名稱</th>
                        <th>主要聯絡窗口</th>
                        <th>聯絡電話</th>
                        <th>公司地址</th>
                        <th class="text-center">合作狀態</th>
                        <th class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody id="suppliersTableBody">
                    <tr><td colspan="7" class="text-center py-4 text-muted">載入供應商清單中...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- 視圖 6：系統使用者與部門權限管理完整大表 (View: Users) -->
<!-- ======================================================== -->
<div id="view-users" class="erp-view d-none">
    <div class="card border-0 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h3 class="card-title fw-bold m-0"><i class="ti ti-users-group text-primary me-2"></i>系統使用者與權限管理</h3>
                <div class="text-muted small">RBAC 四級角色權限防護、部門單位資料隔離防線</div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-secondary" onclick="loadUsersTable()">
                    <i class="ti ti-refresh me-1"></i>刷新
                </button>
                <button type="button" class="btn btn-sm btn-primary fw-bold role-admin-only" onclick="openCreateUserDrawer()">
                    <i class="ti ti-user-plus me-1"></i>建立新帳號
                </button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover">
                <thead>
                    <tr>
                        <th>登入帳號</th>
                        <th>顯示姓名</th>
                        <th>角色身分</th>
                        <th>所屬部門 / 單位 (資料隔離)</th>
                        <th>帳號狀態</th>
                        <th>建立日期</th>
                    </tr>
                </thead>
                <tbody id="usersTableBody">
                    <tr><td colspan="6" class="text-center py-4 text-muted">載入使用者清單中...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 彈窗組件 (Modals) -->
<partial name="_ProductModal" />
<partial name="_StockModal" />

@section Scripts {
<script>
    let currentProductsList = [];
    let cachedSuppliers = [];
    let currentActiveView = 'dashboard';

    document.addEventListener("DOMContentLoaded", () => {
        refreshDashboard();
        // 預設載入供應商清單備用
        loadSuppliersForPO();

        // 採購單選取供應商與商品連動事件監聽
        const poSupSelect = document.getElementById("poSupplierSelect");
        if (poSupSelect) {
            poSupSelect.addEventListener("change", onPoSupplierChanged);
        }
        const poProdSelect = document.getElementById("poProductSelect");
        if (poProdSelect) {
            poProdSelect.addEventListener("change", onPoProductChanged);
        }
    });

    // ==========================================
    // 1. SPA 視圖切換引擎 (View Switcher)
    // ==========================================
    function switchView(viewName) {
        currentActiveView = viewName;

        // 隱藏所有視圖
        document.querySelectorAll('.erp-view').forEach(v => v.classList.add('d-none'));

        // 顯示目標視圖
        const target = document.getElementById(`view-${viewName}`);
        if (target) target.classList.remove('d-none');

        // 更新側邊欄 active 標示
        document.querySelectorAll('.nav-menu-link').forEach(a => a.classList.remove('active'));
        const navEl = document.getElementById(`navItem-${viewName}`);
        if (navEl) navEl.classList.add('active');

        // 更新 Header 標題文字
        const titleMap = {
            'dashboard': '營運總覽儀表板',
            'products': '商品即時庫存總表',
            'low-stock': '安全庫存急需補貨警戒區',
            'purchases': '採購訂購單管理大表 (PO)',
            'suppliers': '合作供應商主檔資料維護',
            'users': '系統使用者與部門權限管理'
        };
        const titleEl = document.getElementById('currentViewTitle');
        if (titleEl && titleMap[viewName]) {
            titleEl.innerText = titleMap[viewName];
        }

        // 依據進入的視圖觸發對應的大表加載
        if (viewName === 'dashboard') refreshDashboard();
        else if (viewName === 'products') loadProducts();
        else if (viewName === 'low-stock') loadLowStock();
        else if (viewName === 'purchases') loadPurchaseOrdersTable();
        else if (viewName === 'suppliers') loadSuppliersTable();
        else if (viewName === 'users') loadUsersTable();

        applyRolePermissions();
    }

    // 重新整理儀表板數據
    async function refreshDashboard() {
        await Promise.all([
            loadProductsSummary(),
            loadLowStock(),
            loadPoSummary()
        ]);
    }

    function handleFilterKey(e) {
        if (e.key === "Enter") loadProducts();
    }

    // ==========================================
    // 2. 商品即時庫存大表與 KPI (Products)
    // ==========================================
    async function loadProductsSummary() {
        try {
            const res = await fetch('/api/v1/products?pageNumber=1&pageSize=100');
            if (!res.ok) return;
            const data = await res.json();
            currentProductsList = data.items;

            document.getElementById("kpiTotalProducts").innerText = data.totalCount;
            let totalStock = 0;
            currentProductsList.forEach(p => totalStock += p.currentQty);
            document.getElementById("kpiTotalStock").innerText = totalStock.toLocaleString();
        } catch (e) {
            console.error(e);
        }
    }

    async function loadProducts() {
        const search = document.getElementById("filterSearch").value.trim();
        const category = document.getElementById("filterCategory").value;
        const tbody = document.getElementById("productsTableBody");

        let url = `/api/v1/products?pageNumber=1&pageSize=100`;
        if (search) url += `&search=${encodeURIComponent(search)}`;
        if (category) url += `&category=${encodeURIComponent(category)}`;

        try {
            const res = await fetch(url);
            if (!res.ok) throw new Error("讀取商品失敗");
            const data = await res.json();
            currentProductsList = data.items;

            document.getElementById("paginationInfo").innerText = `顯示第 1 至 ${currentProductsList.length} 筆，共 ${data.totalCount} 筆商品品項`;

            if (currentProductsList.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-muted">目前暫無商品，請點擊上方「+ 新增商品」建立第一筆資料！</td></tr>`;
                return;
            }

            let rows = "";
            currentProductsList.forEach(p => {
                const isLow = p.isLowStock;
                const statusBadge = isLow
                    ? `<span class="badge bg-danger-lt"><i class="ti ti-alert-circle me-1"></i>庫存吃緊</span>`
                    : `<span class="badge bg-success-lt"><i class="ti ti-check me-1"></i>庫存充裕</span>`;

                const progressColor = isLow ? "bg-danger" : "bg-primary";
                const ratio = p.safetyStock > 0 ? Math.min(100, Math.round((p.currentQty / (p.safetyStock * 2)) * 100)) : 100;
                const supDisplay = p.supplierName 
                    ? `<span class="badge bg-blue-lt" title="主要供應商"><i class="ti ti-building-store me-1"></i>${p.supplierName}</span>` 
                    : `<span class="text-muted small">未指定</span>`;

                rows += `
                <tr>
                    <td class="font-monospace text-primary fw-bold">${p.sku}</td>
                    <td class="fw-semibold">${p.name}</td>
                    <td><span class="badge bg-secondary-lt">${p.category}</span></td>
                    <td>${supDisplay}</td>
                    <td class="text-end font-monospace price-cost-cell" data-raw-price="NT$ ${p.unitPrice.toFixed(2)}">NT$ ${p.unitPrice.toFixed(2)}</td>
                    <td>
                        <div class="d-flex align-items-center">
                            <span class="me-2 fw-bold font-monospace">${p.currentQty} 件</span>
                            ${p.onOrderQty > 0 ? `<span class="badge bg-purple-lt ms-1" title="在途量"><i class="ti ti-truck-delivery me-1"></i>在途:${p.onOrderQty}</span>` : ''}
                            <div class="progress progress-sm flex-grow-1 ms-2" style="height: 6px;">
                                <div class="progress-bar ${progressColor}" style="width: ${ratio}%"></div>
                            </div>
                        </div>
                    </td>
                    <td class="text-center font-monospace text-muted">${p.safetyStock} 件</td>
                    <td class="text-center">${statusBadge}</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary me-1 role-purchaser-only" onclick="openEditProductModal('${p.id}')" title="編輯商品主檔">
                            <i class="ti ti-edit"></i> 編輯
                        </button>
                        <button class="btn btn-sm btn-outline-success me-1" onclick="openStockModal('${p.id}', 'INBOUND')" title="進貨入庫">
                            <i class="ti ti-plus"></i> 入庫
                        </button>
                        <button class="btn btn-sm btn-outline-danger me-1" onclick="openStockModal('${p.id}', 'OUTBOUND')" title="銷貨出庫">
                            <i class="ti ti-minus"></i> 出庫
                        </button>
                        <button class="btn btn-sm btn-outline-info role-manager-only" onclick="openStocktakeDrawer('${p.id}', '${p.name.replace(/'/g, "\\'")}', ${p.currentQty})" title="主管盤點校正">
                            <i class="ti ti-adjustments-alt"></i> 盤點
                        </button>
                    </td>
                </tr>`;
            });
            tbody.innerHTML = rows;
            applyRolePermissions();
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-danger"><i class="ti ti-x me-1"></i>連線失敗：${err.message}</td></tr>`;
        }
    }

    // ==========================================
    // 3. 安全庫存預警 (Low Stock)
    // ==========================================
    async function loadLowStock() {
        const tbody = document.getElementById("lowStockTableBody");
        const dashTbody = document.getElementById("dashLowStockTbody");
        try {
            const res = await fetch("/api/v1/inventory/low-stock");
            if (!res.ok) return;
            const data = await res.json();

            document.getElementById("kpiLowStockCount").innerText = data.length;

            if (data.length === 0) {
                const emptyHtml = `<tr><td colspan="6" class="text-center py-3 text-success"><i class="ti ti-circle-check me-1"></i>所有商品庫存皆在安全水位以上，無需急迫採購。</td></tr>`;
                if (tbody) tbody.innerHTML = emptyHtml;
                if (dashTbody) dashTbody.innerHTML = `<tr><td colspan="5" class="text-center py-3 text-success">庫存安全水位充足</td></tr>`;
                return;
            }

            let rows = "";
            let dashRows = "";
            data.forEach(p => {
                const suggestBuy = Math.max(10, (p.safetyStock * 2) - p.currentQty);
                rows += `
                <tr>
                    <td class="font-monospace text-danger fw-bold">${p.sku}</td>
                    <td>${p.name}</td>
                    <td class="font-monospace text-danger fw-bold">${p.currentQty} 件</td>
                    <td class="font-monospace text-muted">${p.safetyStock} 件</td>
                    <td class="font-monospace text-primary fw-semibold">+${suggestBuy} 件</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-success" onclick="openStockModal('${p.id}', 'INBOUND')">
                            <i class="ti ti-truck-loading me-1"></i>立即補貨
                        </button>
                    </td>
                </tr>`;

                dashRows += `
                <tr>
                    <td class="font-monospace text-danger">${p.sku}</td>
                    <td>${p.name}</td>
                    <td class="text-danger fw-bold">${p.currentQty}</td>
                    <td class="text-muted">${p.safetyStock}</td>
                    <td class="text-end">
                        <button class="btn btn-xs btn-outline-success py-0 px-2" onclick="openStockModal('${p.id}', 'INBOUND')">補貨</button>
                    </td>
                </tr>`;
            });
            if (tbody) tbody.innerHTML = rows;
            if (dashTbody) dashTbody.innerHTML = dashRows;
        } catch (err) {
            console.error(err);
        }
    }

    // ==========================================
    // 4. 採購單管理全寬大表 (Purchases)
    // ==========================================
    async function loadPurchaseOrdersTable() {
        const tbody = document.getElementById("poTableBody");
        tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-1"></span>載入採購單數據中...</td></tr>`;

        try {
            let url = "/api/v1/purchase-orders";
            const filterDeptSelect = document.getElementById("filterPoDepartment");
            const filterStatusSelect = document.getElementById("filterPoStatus");
            const params = [];
            if (filterDeptSelect && filterDeptSelect.value) params.push(`department=${encodeURIComponent(filterDeptSelect.value)}`);
            if (filterStatusSelect && filterStatusSelect.value) params.push(`status=${encodeURIComponent(filterStatusSelect.value)}`);
            if (params.length > 0) url += `?${params.join('&')}`;

            const res = await fetch(url);
            if (!res.ok) throw new Error("讀取採購單失敗");
            const pos = await res.json();

            if (pos.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-muted">目前暫無採購單，請點擊右上角「+ 建立採購單」進行送審！</td></tr>`;
                return;
            }

            let html = "";
            pos.forEach(po => {
                let statusBadge = "";
                let actionBtns = "";

                if (po.status === "Draft") {
                    statusBadge = `<span class="badge bg-secondary-lt">草稿 / 待審</span>`;
                    actionBtns = `<button class="btn btn-sm btn-outline-success role-manager-only me-1" onclick="approvePO('${po.id}')"><i class="ti ti-check me-1"></i>核准</button>`;
                } else if (po.status === "Approved") {
                    statusBadge = `<span class="badge bg-warning-lt">已核准在途</span>`;
                    actionBtns = `<button class="btn btn-sm btn-success me-1" onclick="receiveAllPO('${po.id}')"><i class="ti ti-truck-delivery me-1"></i>到貨驗收</button>`;
                } else if (po.status === "Completed") {
                    statusBadge = `<span class="badge bg-success-lt">已全到結案</span>`;
                    actionBtns = `<span class="text-muted small me-2"><i class="ti ti-circle-check text-success"></i> 結案</span>`;
                }

                // 明細摘要
                const itemsSummary = po.items.map(i => `${i.productName} &times; ${i.orderedQty} (已收:${i.receivedQty})`).join(", ");
                const timeStr = new Date(po.createdAt).toLocaleDateString("zh-TW");

                html += `
                <tr>
                    <td class="font-monospace text-primary fw-bold">${po.poNumber}</td>
                    <td><span class="badge bg-purple-lt">${po.department || "總務課"}</span></td>
                    <td class="fw-semibold">${po.supplierName}</td>
                    <td class="small text-secondary">${itemsSummary}</td>
                    <td class="text-end font-monospace fw-bold price-cost-cell" data-raw-price="NT$ ${po.totalAmount.toLocaleString()}">NT$ ${po.totalAmount.toLocaleString()}</td>
                    <td class="text-center">${statusBadge}</td>
                    <td class="small text-muted">${po.createdBy} <span class="text-secondary">(${timeStr})</span></td>
                    <td class="text-end">${actionBtns}</td>
                </tr>`;
            });

            tbody.innerHTML = html;
            applyRolePermissions();
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-danger">${err.message}</td></tr>`;
        }
    }

    async function loadPoSummary() {
        const container = document.getElementById("dashPoSummaryContainer");
        try {
            const res = await fetch("/api/v1/purchase-orders");
            if (!res.ok) return;
            const pos = await res.json();
            const pendingPos = pos.filter(p => p.status === "Approved" || p.status === "Draft").slice(0, 3);

            if (pendingPos.length === 0) {
                container.innerHTML = `<div class="text-center text-muted py-3">目前無在途等貨中的採購單</div>`;
                return;
            }

            let html = "";
            pendingPos.forEach(po => {
                html += `
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div>
                        <div class="fw-bold font-monospace text-primary">${po.poNumber}</div>
                        <div class="small text-secondary">${po.supplierName} &bull; ${po.items[0]?.productName || "商品"}</div>
                    </div>
                    <div>
                        ${po.status === "Approved" ? '<span class="badge bg-warning-lt">在途</span>' : '<span class="badge bg-secondary-lt">草稿</span>'}
                    </div>
